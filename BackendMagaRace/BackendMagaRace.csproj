<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- El deploy publica a "publish/" dentro de esta misma carpeta de proyecto.
		     Sin esta exclusión, cada publish detecta la salida del publish anterior
		     como si fuera contenido del proyecto y la vuelve a copiar dentro de sí
		     misma (publish/publish/publish/...), acumulando basura en cada deploy. -->
		<DefaultItemExcludes>$(DefaultItemExcludes);publish/**</DefaultItemExcludes>
	</PropertyGroup>

	<ItemGroup>
		<!-- JWT Authentication -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.6" />

		<!-- Entity Framework Core -->
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.6" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.6">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>

		<!-- PostgreSQL Provider -->
		<PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />

		<!-- Swagger / OpenAPI -->
		<PackageReference Include="Microsoft.OpenApi" Version="1.6.22" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
		<PackageReference Include="TransbankSDK" Version="7.2.0" />
	</ItemGroup>

</Project>
